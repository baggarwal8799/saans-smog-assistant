# ─────────────────────────────────────────────────────────────────────────────
# Saans configuration. Copy this file to .env and fill in what you need:
#     cp .env.example .env
# Only GEMINI_API_KEY matters for the AI assistant. Without it, everything else
# works (live air, plan, impacts) and "Ask Saans" shows how to add a key.
# .env is gitignored. Never commit real keys.
# ─────────────────────────────────────────────────────────────────────────────

# ── Google Gemini (free tier: https://ai.google.dev/gemini-api/docs/pricing) ──
# How to get a key (about 2 minutes, free, no card needed):
#   1. Open https://aistudio.google.com/apikey and sign in with a Google account.
#   2. Click "Create API key" (choose or create any Google Cloud project if asked).
#   3. Copy the key and paste it below, with no quotes and no spaces.
#   4. Restart the app (docker compose up -d, or npm run dev / npm start).
# Free-tier note: Google may use free-tier prompts to improve its products,
# so don't type personal details into the assistant.
GEMINI_API_KEY=
# Optional model override. Default: gemini-flash-lite-latest (always the newest free Flash-Lite,
# fastest under load). Busy or unavailable requests are retried on gemini-3.1-flash-lite, then
# gemini-flash-latest. Leave as is unless you have a reason to change it.
GEMINI_MODEL=gemini-flash-lite-latest
# Two daily caps protect the free Gemini quota. They start again at 00:00 UTC and, like the per-minute
# limit, are shared across instances when Upstash is configured (below), and per instance otherwise.
# The assistant also refuses any POST that is not from the app's own page (same Origin).
# 1. Global ceiling on Gemini HTTP calls per UTC day (every fallback model, retry and repair is one); above it the assistant
#    answers "rate limited" for everyone.
MAX_AI_CALLS_PER_DAY=1000
# 2. Per-client ceiling on answered requests per UTC day, keyed by client IP, so one client cannot use up the
#    global cap. A request and its repair retry count as one; answers served from the cache are not counted.
MAX_AI_REQUESTS_PER_CLIENT_PER_DAY=60

# ── Shared limits (optional; Upstash Redis, free tier: https://upstash.com/pricing) ──
# Set both to count the rate limit and the daily caps in one Redis shared by every instance, so a serverless
# cold start does not reset them. Vercel's Upstash integration (Marketplace) sets both for you. Left empty,
# each instance counts in its own memory. If Redis fails, the global cap refuses (protecting the Gemini
# quota) and the per-client limits count in memory until it is back.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# ── Server (Docker / npm start only; ignored by npm run dev and Vercel) ──────
# Host port to open the app on: http://localhost:8080
PORT=8080
# Set to true only when a reverse proxy (nginx, Caddy, a load balancer) sits in
# front and sets X-Forwarded-For. Otherwise clients could fake it to bypass the
# rate limit.
TRUST_PROXY=false
# Set to true only when the site is served over HTTPS (e.g. behind a TLS proxy).
# It turns on HSTS and upgrade-insecure-requests, which break plain-HTTP localhost.
SERVE_HTTPS_HEADERS=false
